FROM sebastianluen/wsbase:latest

WORKDIR /usr/app/

COPY ./repos/trade/src /usr/app/trade/src/
COPY ./repos/research /usr/app/research

ENV PYTHONPATH="/usr/app/Cbc-releases.2.10.11-msvs-w64-mingw64/bin:/usr/app/research:/usr/app/trade"

# Initialize Julia environment
ENV PATH_TRADE="/mnt/trade"
ENV PATH="/usr/app/research:/usr/app/trade:/root/.juliaup/bin:${PATH}"
ENV PYTHON_JULIACALL_HANDLE_SIGNALS="yes"
WORKDIR /usr/app/research/fino
# Install Julia packages
RUN julia --project=/usr/app/research/fino -e "using Pkg; Pkg.instantiate(); Pkg.precompile();"
RUN julia --project=/usr/app/research/fino -e ' \
    using CUDA; \
    CUDA.set_runtime_version!(v"13.2"); \
    ' \
# Precompile with GPU available (requires --gpus all during build)
RUN julia --project=/usr/app/research/fino -e ' \
    using Fino; \
    '

WORKDIR /usr/app/research/docker/
RUN chmod +x runServerProcesses.sh

ENTRYPOINT [ "./runServerProcesses.sh" ]
